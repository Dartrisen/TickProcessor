load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

cc_library(
    name = "app_support",
    hdrs = [
        "include/quant/core/config.hpp",
        "include/quant/telemetry/console_reporter.hpp",
    ],
    includes = ["include"],
    deps = [
        "@kinetic_model",
    ],
)

cc_binary(
    name = "sim_runner",
    srcs = ["sim_runner.cpp"],
    copts = [
        "-std=c++20",
        "-O3",
        "-march=native",
    ],
    data = [
        "//:quant.env",
    ],
    deps = [
        ":app_support",
        "@execution_simulator",
        "@kinetic_model",
        "@market_simulator",
    ],
)
