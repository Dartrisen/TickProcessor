# ==============================================================================
# KINETIC QUANT TRADING ENGINE - CONFIGURATION (quant.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATA INGESTION & WALK-FORWARD CALIBRATION
# ------------------------------------------------------------------------------
# Path to historical OHLCV CSV dataset
DATA_PATH=data/SPY_clean_1min.csv

# Fraction in (0.0, 1.0) used for initial in-sample calibration; remainder runs OOS
TRAIN_SPLIT_RATIO=0.70

# Bars between rolling kernel rebuilds (0 = static warmup kernel; 390 = 1 trading day of 1m bars)
MODEL_RECALIBRATION_BARS=390


# ------------------------------------------------------------------------------
# 2. KINETIC MODEL & FEATURE ENGINEERING (Compile-Time Dispatched)
# ------------------------------------------------------------------------------
# Transition kernel estimator: empirical | gaussian | dirichlet | phase_space
MODEL_KERNEL=empirical

# State discretization grid size (supported: 8, 12, 16, 24, 32, 64)
MODEL_BINS=16

# Symmetric log-return domain [-X_MAX, +X_MAX] (0.015 = +/-1.5%; outliers clamp to edge bins)
MODEL_X_MAX=0.015

# Forward steps [1..10] evaluated for expected return and tail risk
MODEL_FORECAST_HORIZON=3

# Rolling lookback window in bars for volatility (supported: 10, 14, 20, 30, 50, 60)
FEATURE_VOLATILITY_WINDOW=20


# ------------------------------------------------------------------------------
# 3. ALPHA HURDLES & DIRECTIONAL SIGNAL THRESHOLDS
# ------------------------------------------------------------------------------
# Minimum expected log-return E[r] to open/reverse (should exceed round-trip fees + slippage)
RISK_MIN_EXPECTED_RETURN=0.00005

# Alpha-fade exit threshold: closes LONG if E[r] < threshold, SHORT if E[r] > -threshold
RISK_EXIT_EXPECTED_RETURN=0.0

# Directional probability P(r > 0) cutoffs for BUY (long) and SELL (short) entries
RISK_MIN_BULLISH_PROB=0.52
RISK_MAX_BEARISH_PROB=0.48


# ------------------------------------------------------------------------------
# 4. PORTFOLIO TAIL RISK & UNCERTAINTY LIMITS
# ------------------------------------------------------------------------------
# Max 95% VaR & CVaR as positive fractions of equity (0.010 = 1.0%).
# Checked against the left tail for LONGs and right tail for SHORTs, scaled by exposure.
RISK_MAX_VAR_95=0.010
RISK_MAX_CVAR_95=0.015

# Optional tighter right-tail caps for SHORT positions (inherits general limits if omitted or < 0)
# RISK_SHORT_MAX_VAR_95=0.0030
# RISK_SHORT_MAX_CVAR_95=0.0045

# Max forecast Shannon entropy in bits (uniform max = log2(MODEL_BINS), e.g. 4.0 for 16 bins).
# Breaching vetoes new entries and triggers an immediate flatten on open positions.
RISK_MAX_ENTROPY=3.20


# ------------------------------------------------------------------------------
# 5. EXECUTION TIMING, POSITION SIZING & LIFECYCLE
# ------------------------------------------------------------------------------
# Hold-duration bounds in bars (MAX_HOLD_BARS=0 disables forced time-stop)
RISK_MIN_HOLD_BARS=3
RISK_MAX_HOLD_BARS=0

# Re-evaluate forecast & tail risk at next bar open after subtracting gap ln(O_{t+1} / C_t)
RISK_RECHECK_AT_OPEN=true

# Scale position size down to fit VaR/CVaR limits (true), or enforce fixed SIM_ALLOCATION_PCT (false)
RISK_DYNAMIC_SIZING=true


# ------------------------------------------------------------------------------
# 6. SIMULATED EXCHANGE, BRACKETS & BROKERAGE FEES
# ------------------------------------------------------------------------------
SIM_INITIAL_CAPITAL=10000.0
SIM_ALLOCATION_PCT=0.95

# Intra-bar protective stop-loss and take-profit fractions from entry price (0.0 = disabled)
SIM_STOP_LOSS_PCT=0.0
SIM_TAKE_PROFIT_PCT=0.0

# Transaction costs: variable rate (0.0001 = 1 bps), flat ticket fee ($), and slippage (1 bps)
SIM_COMMISSION_RATE=0.0001
SIM_FIXED_FEE=0.00
SIM_SLIPPAGE_BPS=0.0001

# Annualization factor for Sharpe ratio (98280 = 252 trading days * 390 1-min bars)
SIM_BARS_PER_YEAR=98280
