# ==============================================================================
# KINETIC QUANT TRADING ENGINE - SYSTEM CONFIGURATION FILE (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MODEL & BINNING PARAMETERS (Dispatched to constexpr Hot Path Templates)
# ------------------------------------------------------------------------------
# MODEL_BINS: Number of state discretization bins for probability density evolution.
# Supported compile-time buckets: 8, 12, 16, 24, 32, 64
MODEL_BINS=16

# MODEL_X_MAX: Symmetric log-return window max limit (+/- 1.5% = 0.015).
# Returns outside [-X_MAX, +X_MAX] are clamped to boundary bins.
MODEL_X_MAX=0.015

# FEATURE_VOLATILITY_WINDOW: Rolling window size (in bars) for volatility calculation.
# Supported compile-time buckets: 10, 14, 20, 30, 50, 60
FEATURE_VOLATILITY_WINDOW=20

# TRAIN_SPLIT_RATIO: Fraction of historical bars used for in-sample kernel calibration.
# Remaining bars (1 - TRAIN_SPLIT_RATIO) run out-of-sample simulation without lookahead bias.
TRAIN_SPLIT_RATIO=0.70

# MODEL_FORECAST_HORIZON: Number of forward bars evaluated for expected return and tail risk.
# Also acts as the maximum holding time-stop (bars_held >= MODEL_FORECAST_HORIZON closes to flat
# unless a fresh directional signal renews the position).
MODEL_FORECAST_HORIZON=3


# ------------------------------------------------------------------------------
# 2. PRE-TRADE RISK ENGINE LIMITS & ALPHA HURDLE RATES
# ------------------------------------------------------------------------------
# Direction-Aware Tail Selection:
#   - LONG positions/candidates are checked against the LEFT tail (downside crash risk).
#   - SHORT positions/candidates are checked against the RIGHT tail (upside rally/squeeze risk).
#   - Both VaR and CVaR are scaled by post-trade gross portfolio exposure (|Notional| / Equity)
#     and checked on new entries, reversals, and existing open positions (triggering auto-flatten).

# RISK_MAX_VAR_95: Maximum allowable portfolio 95% Value-at-Risk (positive fractional loss).
# Caps the 95th-percentile loss threshold across the forecast horizon (e.g., 0.010 = 1.0% of equity).
RISK_MAX_VAR_95=0.010

# RISK_MAX_CVAR_95: Maximum allowable portfolio 95% Conditional VaR / Expected Shortfall.
# Caps the average loss across the worst 5% tail outcomes beyond VaR (protects against fat tails).
RISK_MAX_CVAR_95=0.015

# RISK_SHORT_MAX_VAR_95 / RISK_SHORT_MAX_CVAR_95 (Optional Short-Side Overrides):
# Separate right-tail limits applied exclusively to SHORT candidates and open short positions.
# Uncomment to enforce tighter caps on asymmetric upside squeeze risk (values must sit within
# the observed multi-bar upper tail to actively bind, e.g., 0.0020-0.0040 on 1-min SPY).
# If omitted or < 0, short positions inherit RISK_MAX_VAR_95 and RISK_MAX_CVAR_95.
# RISK_SHORT_MAX_VAR_95=0.0030
# RISK_SHORT_MAX_CVAR_95=0.0045

# RISK_MAX_ENTROPY: Maximum allowed predictive uncertainty (in bits).
# High entropy = flatter / less informative forecast. For 16 bins, uniform is log2(16) = 4.0 bits.
# Breaching this limit vetoes new entries and triggers a flatten exit on open positions.
RISK_MAX_ENTROPY=3.20

# RISK_MIN_EXPECTED_RETURN: Minimum expected log-return hurdle rate (alpha floor) to open/reverse.
# Must comfortably exceed round-trip slippage + commission to prevent fee churn.
RISK_MIN_EXPECTED_RETURN=0.00005

# RISK_EXIT_EXPECTED_RETURN: Alpha-fade exit threshold (emits OrderSignal::Close to go flat).
# Closes an open LONG when E[r] < RISK_EXIT_EXPECTED_RETURN (or P(r>0) < 0.50),
# and closes an open SHORT when E[r] > -RISK_EXIT_EXPECTED_RETURN (or P(r>0) > 0.50).
RISK_EXIT_EXPECTED_RETURN=0.0

# RISK_MIN_BULLISH_PROB: Minimum directional bullish probability P(r > 0) for BUY (target long).
RISK_MIN_BULLISH_PROB=0.52

# RISK_MAX_BEARISH_PROB: Maximum directional probability P(r > 0) for SELL (target short).
RISK_MAX_BEARISH_PROB=0.48


# ------------------------------------------------------------------------------
# 3. EXECUTION TIMING, SIZING & POSITION LIFECYCLE CONTROLS
# ------------------------------------------------------------------------------
# RISK_MIN_HOLD_BARS: Minimum bars to hold an open position before allowing non-emergency exits/flips.
RISK_MIN_HOLD_BARS=3

# RISK_MAX_HOLD_BARS: Optional forced time-stop in bars (0 = disabled; positions exit via alpha fade, reversal, brackets, or risk limits).
RISK_MAX_HOLD_BARS=0

# RISK_RECHECK_AT_OPEN: Re-evaluate forecast & VaR/CVaR at bar i+1 open after subtracting the
# realized inter-bar gap ln(O_{i+1} / C_i). Cancels stale entries if the gap consumed the edge.
RISK_RECHECK_AT_OPEN=true

# RISK_DYNAMIC_SIZING: Scale position allocation down to max_allowed_allocation_pct when full
# SIM_ALLOCATION_PCT would exceed VaR/CVaR limits (true), or use fixed SIM_ALLOCATION_PCT (false).
RISK_DYNAMIC_SIZING=true


# ------------------------------------------------------------------------------
# 4. SIMULATED EXCHANGE, BRACKETS & BROKERAGE FEE STRUCTURE
# ------------------------------------------------------------------------------
# SIM_INITIAL_CAPITAL: Account starting balance in USD ($10,000.00).
SIM_INITIAL_CAPITAL=10000.0

# SIM_ALLOCATION_PCT: Target fraction of account equity allocated per position entry (0.95 = 95%).
SIM_ALLOCATION_PCT=0.95

# SIM_STOP_LOSS_PCT: Intra-bar protective stop-loss fraction from entry price (0.0 = disabled).
# Example: 0.0030 triggers an intra-bar stop exit on a 0.30% adverse move.
SIM_STOP_LOSS_PCT=0.0

# SIM_TAKE_PROFIT_PCT: Intra-bar profit-target fraction from entry price (0.0 = disabled).
# Example: 0.0050 triggers an intra-bar take-profit exit on a 0.50% favorable move.
SIM_TAKE_PROFIT_PCT=0.0

# SIM_COMMISSION_RATE: Brokerage variable trade value fee (0.0001 = 1 bps / 0.01% per trade).
SIM_COMMISSION_RATE=0.0001

# SIM_FIXED_FEE: Flat ticket fee per executed order in USD ($0.00 for commission-free brokers).
SIM_FIXED_FEE=0.00

# SIM_SLIPPAGE_BPS: Bid-Ask execution slippage penalty in basis points (0.0001 = 1 bps).
SIM_SLIPPAGE_BPS=0.0001


# ------------------------------------------------------------------------------
# 5. INGESTION & CALIBRATION PIPELINE
# ------------------------------------------------------------------------------
# DATA_PATH: Path to historical CSV tick file.
DATA_PATH=data/SPY_clean_1min.csv

# ASYNC_CALIBRATION_MS: Interval (ms) for background thread to rebuild W kernel.
ASYNC_CALIBRATION_MS=500
