# ==============================================================================
# KINETIC QUANT TRADING ENGINE - SYSTEM CONFIGURATION FILE (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MODEL & BINNING PARAMETERS (Hot Path Numerical Core)
# ------------------------------------------------------------------------------
# BINS: Number of state discretization bins for probability density evolution (f_{t+1} = W * f_t).
# Must match matrix template parameter (default: 16). Higher = finer resolution.
MODEL_BINS=16

# X_MAX: Symmetric log-return window max limit (+/- 1.5% = 0.015).
# Returns outside [-X_MAX, +X_MAX] are clamped to boundary bins.
MODEL_X_MAX=0.015

# VOLATILITY_WINDOW: Rolling window size (in ticks/bars) for rolling volatility calculations.
FEATURE_VOLATILITY_WINDOW=20


# ------------------------------------------------------------------------------
# 2. PRE-TRADE RISK ENGINE LIMITS & ALPHA HURDLE RATES
# ------------------------------------------------------------------------------
# MAX_VAR_95: Maximum allowable 95% Value-at-Risk (tail log-loss limit).
# If 95% VaR exceeds this value (e.g. 0.05 = 5%), RiskEngine vetoes the trade -> HOLD.
RISK_MAX_VAR_95=0.05

# MIN_ENTROPY: Minimum predictive certainty threshold (in bits).
# If the evolved probability density is too flat/uncertain (entropy < limit), trade is vetoed -> HOLD.
RISK_MIN_ENTROPY=0.50

# MIN_EXPECTED_RETURN: Minimum expected log-return hurdle rate (alpha floor) required to trigger a trade.
# 0.00005 = +0.005% return floor per 1-min step.
RISK_MIN_EXPECTED_RETURN=0.00005

# MIN_BULLISH_PROB: Minimum directional bullish probability P(r > 0) to execute BUY signal (e.g., 0.52 = 52%).
RISK_MIN_BULLISH_PROB=0.52

# MAX_BEARISH_PROB: Maximum directional probability P(r > 0) to execute SELL signal (e.g., 0.48 = 48%).
RISK_MAX_BEARISH_PROB=0.48


# ------------------------------------------------------------------------------
# 3. SIMULATED EXCHANGE & BROKERAGE FEE STRUCTURE
# ------------------------------------------------------------------------------
# INITIAL_CAPITAL: Account starting balance in USD for paper trading / backtesting ($100,000.00).
SIM_INITIAL_CAPITAL=100000.0

# POSITION_ALLOCATION_PCT: Fraction of total available cash allocated per position (0.95 = 95%).
SIM_ALLOCATION_PCT=0.95

# COMMISSION_RATE: Brokerage variable trade value fee (0.0001 = 1 basis point or 0.01% per trade).
SIM_COMMISSION_RATE=0.0001

# FIXED_FEE_PER_TRADE: Flat ticket fee per executed order in USD ($0.00 for Alpaca commission-free).
SIM_FIXED_FEE=0.00

# SLIPPAGE_BPS: Bid-Ask execution slippage penalty in basis points (0.0001 = 1 bps).
SIM_SLIPPAGE_BPS=0.0001


# ------------------------------------------------------------------------------
# 4. INGESTION & CALIBRATION PIPELINE
# ------------------------------------------------------------------------------
# DATA_PATH: Path to historical CSV tick file.
DATA_PATH=path/to/data/SPY_clean_1min.csv

# ASYNC_CALIBRATION_INTERVAL_MS: Interval (ms) for background thread to rebuild W kernel.
ASYNC_CALIBRATION_MS=500
