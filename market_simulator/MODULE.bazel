module(
    name = "market_simulator",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "kinetic_model", version = "0.1.0")
local_path_override(
    module_name = "kinetic_model",
    path = "../kinetic_model",
)

git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

git_repository(
    name = "lock_free_ring_buffer",
    remote = "https://github.com/Dartrisen/lock-free-ring-buffer.git",
    commit = "4f0c5b9a5df52e3c87edde5062f78362f9663cb9",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "lock_free_ring_buffer",
    hdrs = glob(["include/**/*.hpp"], allow_empty = True),
    includes = ["include"],
    visibility = ["//visibility:public"],
)
""",
)